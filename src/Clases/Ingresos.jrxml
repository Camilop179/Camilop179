	<dataset name="Table Dataset 1" uuid="c1cab1ca-7529-4c0e-acb1-c608ca2b40ad"/>
	<parameter name="NroVentas" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="url" class="java.lang.String"/>
	<query language="sql"><![CDATA[select v.total,v.fecha,v.hora,v.nroIngreso,d.concepto,d.valor,u.nombre as usuario,c.nombres,c.cedula,c.celular from ingreso v join detalleingreso d on v.nroIngreso = d.nroIngreso join usuarios u on u.idUsuarios=v.idUsuario join clientes c on c.idclientes=v.idCliente where v.nroIngreso = $P{NroVentas}]]></query>
