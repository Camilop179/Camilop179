	<dataset name="Table Dataset 1" uuid="c1cab1ca-7529-4c0e-acb1-c608ca2b40ad"/>
	<parameter name="NroVentas" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="url" class="java.lang.String"/>
	<query language="sql"><![CDATA[select distinct v.*,d.*,u.nombre,c.celular,e.Nombre as empleado,m.nroMotor as motor,m.nroChasis as chasis 
from ventas v 
	right join detallesventa d on v.nroVentas = d.nro_venta
	left join usuarios u on u.idUsuarios=v.idUsuario
 	left join clientes c on c.cedula=v.cedula_cliente 
 	left join empleados e on e.id = v.idEmpleado
 	left join motos m on m.placa = v.placa
 where v.nroVentas =  $P{NroVentas} ]]></query>
