<jasperReport name="Factura_Carta" language="java" pageWidth="612" pageHeight="792" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="bea4041f-c630-4f7e-8e5e-e4322fd098b8">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Sample DB"/>
	<parameter name="NroVentas" class="java.lang.String">
		<defaultValueExpression><![CDATA[1101]]></defaultValueExpression>
	</parameter>
	<parameter name="Imagen1" class="java.net.URL"/>
	<parameter name="Imagen2" class="java.net.URL"/>
	<parameter name="Subtotal" class="java.lang.String"/>
	<parameter name="SinIva" class="java.lang.String"/>
	<parameter name="iva" class="java.lang.String"/>
	<query language="SQL"><![CDATA[select distinct v.*,d.*,u.nombre,c.celular,e.Nombre as tecnico , 
	m.nroMotor as motor,m.nroChasis as chasis 
from cotizacion v 
	right join detallescotizacion d on nroCotizacion= nro_Cotizacion
	left join usuarios u on u.idUsuarios=v.idUsuario
 	left join clientes c on c.cedula=v.cedula_cliente 
 	left join empleados e on e.id = v.idEmpleado
 	left join motos m on m.placa = v.placa
 where nroCotizacion =  $P{NroVentas}]]></query>
